@using Emc.Domain.Configuration
@using Microsoft.EntityFrameworkCore
@using Emc.Application.Abstractions
@inject IEmcDbContext Db
@inject ICurrentUser CurrentUser
@{
    // EMC-003 / SEC-003. The authoritative-record notice and the classification banner are
    // driven from configuration and rendered on every page, so that no accountability view can
    // be read without knowing which record is authoritative (AR 195-5 2-5a, 2-5c).
    var configuration = await Db.SystemConfigurations.AsNoTracking().FirstOrDefaultAsync();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Evidence Management Companion</title>
    <link rel="stylesheet" href="~/css/emc.css" asp-append-version="true" />
</head>
<body>
    <div class="classification-banner">
        @(configuration?.AccreditedClassificationLevel ?? "CLASSIFICATION NOT CONFIGURED")
    </div>

    <header class="site-header">
        <div class="site-header__brand">
            <a asp-page="/Index">Evidence Management Companion</a>
            <span class="site-header__org">@configuration?.OrganizationName</span>
        </div>
        <nav class="site-header__nav">
            <a asp-page="/Cases/Index">Cases</a>
            <span class="site-header__user">@CurrentUser.DisplayName</span>
        </nav>
    </header>

    @if (configuration is not null)
    {
        <div class="authoritative-notice" role="note">
            @configuration.AuthoritativeRecordNotice
        </div>
    }
    else
    {
        <div class="authoritative-notice authoritative-notice--error" role="alert">
            System configuration has not been initialised. Until it is, this application must not
            be used to record evidence accountability information. See <code>db/seed-initial.sql</code>.
        </div>
    }

    @if (!CurrentUser.IsAuthenticated)
    {
        @* The fallback policy already required a Windows identity to reach this page, so
           reaching here unauthenticated means the Windows account has no EMC user record.
           Authorization will deny every action, and saying so plainly is better than leaving
           someone to discover it one greyed-out button at a time. *@
        <div class="authoritative-notice authoritative-notice--error" role="alert">
            Your Windows account is not registered in this application, so no actions are
            available to you. Ask an application administrator to add your account. Roles are
            resolved from this application's own records, never from your workstation.
        </div>
    }

    <main class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <p>
            This application assists the AR 195-5 evidence process. It is not the evidence ledger
            and it is not the DA Form 4137. Required signatures remain governed by AR 195-5.
        </p>
    </footer>

    <div class="classification-banner">
        @(configuration?.AccreditedClassificationLevel ?? "CLASSIFICATION NOT CONFIGURED")
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
