@page "{id:int}"
@using Emc.Application.Filing
@using Emc.Domain.Filing
@model Emc.Web.Pages.Vouchers.DetailsModel
@{
    ViewData["Title"] = Model.DisplayIdentifier;
}

<h1>
    DA Form 4137
    <span class="identifier @(Model.HasOfficialDocumentNumber ? "" : "identifier--temporary")">
        @Model.DisplayIdentifier
    </span>
</h1>
<p class="page-subtitle">
    Case <a asp-page="/Cases/Details" asp-route-id="@Model.CaseId"><span class="identifier">@Model.CaseControlNumber</span></a>
    @if (!string.IsNullOrWhiteSpace(Model.RequestingOfficeCaseNumber))
    {
        <text>&middot; requesting office <span class="identifier">@Model.RequestingOfficeCaseNumber</span> (RFA, AR 195-5 para 2-3b)</text>
    }
</p>

<partial name="_Messages" model="Model.Messages" />

@foreach (var warning in Model.AuthorizationWarnings)
{
    <div class="message message--warning" role="alert">
        <strong>Custodian appointment.</strong> <span>@warning</span>
    </div>
}

@if (!Model.HasOfficialDocumentNumber)
{
    <div class="message message--warning" role="note">
        <strong>No official document number.</strong>
        <span>
            This voucher carries the temporary identifier
            <span class="identifier identifier--temporary">@Model.TemporaryIdentifier</span>.
            AR 195-5 para 2-4c requires the evidence custodian to assign the document number by
            order of precedence from the evidence ledger on receipt of the evidence. This
            application does not assign it.
        </span>
    </div>
}

<div class="panel">
    <h2>Voucher</h2>
    <table>
        <tbody>
            <tr><th>Status (derived)</th><td>@Model.DerivedStatus</td></tr>
            <tr><th>Receiving activity</th><td>@Model.ReceivingActivity</td></tr>
            <tr><th>Location</th><td>@Model.ReceivingActivityLocation</td></tr>
            <tr><th>Received from</th><td>@Model.ReceivedFrom</td></tr>
            <tr>
                <th>Acquired</th>
                <td>@Model.AcquiredAtLocal.ToString("dd MMM yy HH:mm").ToUpperInvariant()</td>
            </tr>
        </tbody>
    </table>
    <p class="regulatory-note">
        Status is derived from the items on this voucher, never stored. AR 195-5 para 2-4h makes a
        voucher inactive only after <em>all</em> of its items have been properly disposed.
    </p>
</div>

<div class="panel">
    <h2>Description of articles</h2>
    @if (Model.Items.Count == 0)
    {
        <p>
            No items have been listed. AR 195-5 para 2-3a requires all physical evidence to be
            inventoried and accounted for on the DA Form 4137, so at least one item is needed
            before the voucher can be submitted.
        </p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Description of articles</th>
                    <th>Quantity</th>
                    <th>Serial / unique identifier</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr class="@(item.IsWithdrawnFromForm ? "history-row--superseded" : "")">
                    <td class="numeric">@item.ItemNumber</td>
                    <td>
                        @if (item.IsWithdrawnFromForm)
                        {
                            <span class="badge">withdrawn — entered in error (para 2-3g)</span>
                        }
                        @item.DescriptionForForm
                        @if (item.IsPossibleBiohazard)
                        {
                            <span class="badge badge--biohazard">AR 195-5 2-3l</span>
                        }
                        @if (item.IsSealed)
                        {
                            <span class="badge">sealed</span>
                        }
                    </td>
                    <td>@item.Quantity</td>
                    <td>
                        @item.SerialNumber
                        @if (!string.IsNullOrWhiteSpace(item.UniqueDeviceIdentifier))
                        {
                            <div class="identifier">@item.UniqueDeviceIdentifier</div>
                        }
                    </td>
                    <td><span class="badge badge--@item.AccountabilityStatus.ToString().ToLowerInvariant()">@item.AccountabilityStatus</span></td>
                    <td>
                        <a asp-page="/Items/History" asp-route-id="@item.Id">History</a>
                        @if (Model.CanEditDraft && Model.ReviewStage == VoucherReviewStage.Draft)
                        {
                            <form method="post" asp-page-handler="RemoveItem" asp-route-id="@Model.VoucherId" asp-route-itemId="@item.Id" style="display:inline">
                                <button type="submit" class="secondary">Remove</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>

        @* AR 195-5 para 2-3d - LAST ITEM in capitals, centred, with lines to the margins. *@
        <p style="text-align:center; font-weight:600; letter-spacing:0.05em;">
            ———————————————— LAST ITEM ————————————————
        </p>
        <p class="regulatory-note">
            AR 195-5 para 2-3d: "The words LAST ITEM will be placed in capital letters after the
            last listed item on the next line below that item." Derived from position, so it
            cannot be left behind when items change.
        </p>
    }
</div>

@if (Model.CanEditDraft)
{
    <div class="panel">
        <h2>Add an item</h2>
        <form method="post" asp-page-handler="AddItem" asp-route-id="@Model.VoucherId">
            <div asp-validation-summary="ModelOnly" class="message message--error"></div>

            <div class="form-row">
                <label asp-for="NewItem.Description">Description of articles</label>
                <textarea asp-for="NewItem.Description"></textarea>
                <span class="hint">
                    AR 195-5 para 2-3d: describe the item accurately, to the exclusion of any
                    other item; descriptive information only, no supposition (not "suspected to be
                    marijuana"); permanent characteristics; large numbers as approximations.
                </span>
                <span asp-validation-for="NewItem.Description" class="field-validation-error"></span>
            </div>

            <div class="form-row">
                <label asp-for="NewItem.Quantity">Quantity</label>
                <input asp-for="NewItem.Quantity" autocomplete="off" />
                <span class="hint">
                    Approximations for large numbers, e.g. "approximately 100 tablets". Seized
                    funds are recorded by exact denomination.
                </span>
            </div>

            <div class="form-row">
                <label asp-for="NewItem.SerialNumber">Serial number</label>
                <input asp-for="NewItem.SerialNumber" autocomplete="off" />
                <span class="hint">AR 195-5 para 2-3d: recorded if available.</span>
            </div>

            <div class="form-row">
                <label asp-for="NewItem.UniqueDeviceIdentifier">IMEI or comparable unique device identifier</label>
                <input asp-for="NewItem.UniqueDeviceIdentifier" autocomplete="off" />
            </div>

            <div class="form-row form-row--checkbox">
                <input asp-for="NewItem.IsPossibleBiohazard" type="checkbox" />
                <label asp-for="NewItem.IsPossibleBiohazard">
                    Contains suspected blood or bodily fluids — the description will be annotated
                    <strong>POSSIBLE BIOHAZARD</strong> (AR 195-5 para 2-3l)
                </label>
            </div>

            <div class="form-row form-row--checkbox">
                <input asp-for="NewItem.IsFungible" type="checkbox" />
                <label asp-for="NewItem.IsFungible">Fungible evidence</label>
            </div>

            <div class="form-row form-row--checkbox">
                <input asp-for="NewItem.IsSealed" type="checkbox" />
                <label asp-for="NewItem.IsSealed">Sealed in an evidence container</label>
            </div>

            <div class="form-row">
                <label asp-for="NewItem.SealDescription">Sealing annotation</label>
                <input asp-for="NewItem.SealDescription" autocomplete="off" />
                <span class="hint">
                    Required when sealed. AR 195-5 para 2-3c, for example "sealed in a paper sack
                    which was marked for identification".
                </span>
            </div>

            <button type="submit">Add item</button>
        </form>
    </div>
}

@if (Model.ReviewActions.Count > 0)
{
    <div class="panel">
        <h2>Custodian review (AR 195-5 para 2-3g)</h2>
        <p>Stage: <strong>@Model.ReviewStage</strong></p>
        <table>
            <thead>
                <tr><th>Action</th><th>By</th><th>When</th><th>Details</th></tr>
            </thead>
            <tbody>
            @foreach (var action in Model.ReviewActions)
            {
                <tr>
                    <td>@action.Kind</td>
                    <td>@action.ActorName</td>
                    <td>@action.OccurredAtUtc.ToString("dd MMM yy HH:mm").ToUpperInvariant()Z</td>
                    <td>
                        @action.Narrative
                        @if (action.PaperFormCorrectedAndInitialedAttested == true)
                        {
                            <div class="regulatory-note">
                                Agent attested that the paper DA Form 4137 was corrected and
                                initialed. The application records the attestation; it supplies
                                no initials.
                            </div>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
        <p class="regulatory-note">
            AR 195-5 para 2-3g: "Evidence custodians will review the DA Form 4137 submitted with
            evidence and have the submitting DALEO or Army CI agent correct and initial all
            errors." This is the record of that review. It is not the para 1-7c(3) process,
            which applies to an incorrect entry found after acceptance.
        </p>
    </div>
}

@if (Model.CanReturnForCorrection)
{
    <div class="panel">
        <h2>Return to the submitting agent for correction</h2>
        <form method="post" asp-page-handler="ReturnForCorrection" asp-route-id="@Model.VoucherId">
            <div asp-validation-summary="ModelOnly" class="message message--error"></div>
            <div class="form-row">
                <label asp-for="Return.ErrorsIdentified">Errors identified</label>
                <textarea asp-for="Return.ErrorsIdentified"></textarea>
                <span class="hint">
                    AR 195-5 para 2-3g. State what the submitting agent is to correct and
                    initial on the form. This is recorded and shown to the agent.
                </span>
                <span asp-validation-for="Return.ErrorsIdentified" class="field-validation-error"></span>
            </div>
            <button type="submit">Return for correction</button>
        </form>
    </div>
}

@if (Model.CanWithdrawLine)
{
    <div class="panel">
        <h2>Withdraw a line entered in error</h2>
        <p class="regulatory-note">
            AR 195-5 para 2-3g. A line that never corresponded to a physical item is withdrawn from
            the corrected form. It stays visible on the earlier submitted revision and in its own
            history. <strong>A physical item that was actually acquired cannot be removed this
            way</strong>: it is evidence in your custody and leaves the process only under
            para 2-8, which this application does not yet support. Consult the CI supervisor.
        </p>
        <form method="post" asp-page-handler="WithdrawLine" asp-route-id="@Model.VoucherId">
            <div asp-validation-summary="ModelOnly" class="message message--error"></div>
            <div class="form-row">
                <label asp-for="Withdraw.ItemId">Line</label>
                <select asp-for="Withdraw.ItemId">
                    @foreach (var item in Model.Items.Where(i => !i.IsWithdrawnFromForm))
                    {
                        <option value="@item.Id">Item @item.ItemNumber — @item.DescriptionForForm</option>
                    }
                </select>
            </div>
            <div class="form-row">
                <label asp-for="Withdraw.Reason">Why the line was entered in error</label>
                <textarea asp-for="Withdraw.Reason"></textarea>
                <span asp-validation-for="Withdraw.Reason" class="field-validation-error"></span>
            </div>
            <div class="form-row">
                <label>
                    <input asp-for="Withdraw.AttestsNoPhysicalItemExists" />
                    No physical item corresponds to this line. It was entered in error.
                </label>
            </div>
            <button type="submit">Withdraw line</button>
        </form>
    </div>
}

@if (Model.FormRevisions.Count > 0)
{
    <div class="panel">
        <h2>Submitted form revisions (AR 195-5 para 2-3g)</h2>
        <p class="regulatory-note">
            What the DA Form 4137 contained each time it went to the evidence custodian. The
            current form is the item list above; these are kept as submitted and never change.
        </p>
        @foreach (var revision in Model.FormRevisions)
        {
            <h3>Revision @revision.RevisionNumber — @revision.Kind, @revision.SubmittedByName, @revision.SubmittedAtUtc.ToString("dd MMM yy HH:mm").ToUpperInvariant()Z</h3>
            <table>
                <thead><tr><th>#</th><th>Description</th><th>Qty</th><th>Serial / identifier</th></tr></thead>
                <tbody>
                @foreach (var line in revision.Lines)
                {
                    <tr>
                        <td class="numeric">@line.LineNumber</td>
                        <td>@line.Description</td>
                        <td>@line.Quantity</td>
                        <td>@line.SerialNumber @line.UniqueDeviceIdentifier</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
}

@if (Model.CanRecordAgentCorrection)
{
    <div class="panel">
        <h2>Record the correction</h2>
        <p class="regulatory-note">
            Only the agent who submitted this voucher may record the correction (AR 195-5
            para 2-3g). Edit the items above as needed first; then record here what was
            corrected on the paper form.
        </p>
        <form method="post" asp-page-handler="RecordAgentCorrection" asp-route-id="@Model.VoucherId">
            <div asp-validation-summary="ModelOnly" class="message message--error"></div>
            <div class="form-row">
                <label asp-for="AgentCorrection.WhatWasCorrected">What was corrected</label>
                <textarea asp-for="AgentCorrection.WhatWasCorrected"></textarea>
                <span asp-validation-for="AgentCorrection.WhatWasCorrected" class="field-validation-error"></span>
            </div>
            <div class="form-row">
                <label>
                    <input asp-for="AgentCorrection.PaperFormCorrectedAndInitialedAttested" />
                    I corrected and initialed the errors on the paper DA Form 4137.
                </label>
                <span class="hint">
                    An attestation that the paper form was corrected and initialed as para 2-3g
                    requires. The application does not supply initials or a signature.
                </span>
            </div>
            <button type="submit">Record correction</button>
        </form>
    </div>
}

@if (Model.CanResubmit)
{
    <div class="panel">
        <h2>Resubmit for custodian intake</h2>
        <form method="post" asp-page-handler="Resubmit" asp-route-id="@Model.VoucherId">
            <button type="submit">Resubmit corrected voucher</button>
        </form>
    </div>
}

@if (Model.CanSubmit)
{
    <div class="panel">
        <h2>Submit for custodian intake</h2>
        <p>
            AR 195-5 para 2-4a: except in unusual circumstances, the physical evidence is released
            to the evidence custodian no later than the first working day after it is acquired.
            Submitting here records the electronic voucher; it does not transfer physical custody.
        </p>
        <p class="regulatory-note">
            Once submitted, items can no longer be edited unless the custodian returns the form.
            AR 195-5 para 2-3g has the custodian have the submitting agent correct and initial
            errors on the form; after acceptance, an incorrect entry is corrected by the custodian
            under para 1-7c(3).
        </p>
        <form method="post" asp-page-handler="Submit" asp-route-id="@Model.VoucherId">
            <button type="submit">Submit for custodian intake</button>
        </form>
    </div>
}

@if (Model.PaperAdvisories.Count > 0)
{
    <div class="panel">
        <h2>Paper record and companion record — advisories</h2>
        <p class="hint">Cross-checks between where the paper DA Form 4137 is recorded to be and what the companion record says. Advisory only: nothing here changes a state; a person looks.</p>
        <ul>
        @foreach (var a in Model.PaperAdvisories)
        {
            <li><strong>[@a.Code]</strong> <span class="hint">AR 195-5 @a.Regulation</span> — @a.Message</li>
        }
        </ul>
    </div>
}

@if (Model.PhysicalDocument is { } paper && Model.HasOfficialDocumentNumber)
{
    <div class="panel">
        <h2>Physical DA Form 4137 (paper record)</h2>
        <p class="regulatory-note">
            This is where the <strong>paper</strong> DA Form 4137 is. A scan stored in this
            application is a companion copy and is never the original (AR 195-5 paras 2-4d, 2-4f,
            2-4h). Uploading a scan changes nothing here.
        </p>
        <table>
            <tbody>
                <tr><th>What became of the original</th><td>@paper.OriginalDisposition
                    @if (paper.OriginalDisposition == Emc.Domain.Filing.OriginalDisposition.HeldActive) { <span>(para 2-4f(1))</span> }
                    else if (paper.OriginalDisposition == Emc.Domain.Filing.OriginalDisposition.AccompanyingTemporaryRelease) { <span>(para 2-7b, 2-4f(2): the original is with the evidence, not in any binder)</span> }
                    else if (paper.OriginalDisposition == Emc.Domain.Filing.OriginalDisposition.SentForDispositionApproval) { <span>(para 2-4f(3)(c): the evidence stays in the room)</span> }
                    else if (paper.OriginalDisposition == Emc.Domain.Filing.OriginalDisposition.TransferredToGainingRoom) { <span>(para 2-7g: original and duplicate went with the evidence)</span> }
                </td></tr>
                <tr><th>What this room holds</th><td>@paper.RetainedPaperStatus @(paper.CurrentContainerLabel is null ? "" : $"— in {paper.CurrentContainerLabel}")
                    @if (paper.RetainedPaperStatus == Emc.Domain.Filing.RetainedPaperStatus.SuspenseCopy) { <span>(first copy, para 2-4f(2)/(3); home binder @paper.HomeActiveContainerLabel)</span> }
                    @if (paper.SuspenseCopyFiledWithOriginal) { <span>— first (suspense) copy filed with the original (para 2-7b)</span> }
                </td></tr>
                @if (paper.HoldsCopyOnly && paper.CopyReason != Emc.Domain.Filing.CopyRetentionReason.None)
                {
                    <tr><th>Copy retained because</th><td>@paper.CopyReason (para 2-4g / 2-7g). The original's disposition above is history and is not changed by anything this room later does with its copy.</td></tr>
                }
                <tr><th>Closure basis</th><td>@paper.ClosureBasis</td></tr>
                @if (paper.InactiveSinceUtc is not null)
                {
                    <tr><th>Inactive since</th><td>@paper.InactiveSinceUtc.Value.ToString("dd MMM yyyy").ToUpperInvariant()</td></tr>
                    <tr><th>Paper destruction eligibility</th>
                        <td>
                            @paper.RetentionStatus — eligible @paper.DestructionEligibleAtUtc!.Value.ToString("dd MMM yyyy").ToUpperInvariant()
                            (AR 195-5 para 2-4h: 3 years after the date the record became inactive).
                            @if (paper.DestructionConfirmedAtUtc is not null)
                            {
                                <text>Destruction confirmed @paper.DestructionConfirmedAtUtc.Value.ToString("dd MMM yyyy").ToUpperInvariant().</text>
                            }
                        </td></tr>
                }
            </tbody>
        </table>
        <p class="regulatory-note">
            Eligibility concerns the <strong>evidence room's paper record only</strong>. It does
            not depend on whether the investigation is open, it says nothing about the copy in the
            investigative case file, and it does not schedule or permit destruction of any digital
            record or scan held by this application — those are retained pending the records
            determination in DEC-07. Nothing is destroyed automatically.
        </p>
        @if (paper.Events.Count > 0)
        {
            <table>
                <thead><tr><th>Event</th><th>By</th><th>When</th><th>File</th><th>Details</th></tr></thead>
                <tbody>
                @foreach (var e in paper.Events)
                {
                    <tr>
                        <td>@e.Kind</td>
                        <td>@e.RecordedByName</td>
                        <td>@e.OccurredAtUtc.ToString("dd MMM yy HH:mm").ToUpperInvariant()Z</td>
                        <td>@e.ContainerLabel</td>
                        <td>@e.Narrative</td>
                    </tr>
                }
                </tbody>
            </table>
        }
        @if (Model.CanManagePhysicalFiles)
        {
            <form method="post" asp-page-handler="RecordPhysical" asp-route-id="@Model.VoucherId">
                <div class="form-row">
                    <label asp-for="Physical.Action">Action</label>
                    <select asp-for="Physical.Action" asp-items="Html.GetEnumSelectList<PhysicalDocumentAction>()"></select>
                </div>
                <div class="form-row">
                    <label asp-for="Physical.ContainerId">File / folder</label>
                    <select asp-for="Physical.ContainerId">
                        <option value="">— none —</option>
                        @foreach (var c in paper.RoomContainers.Where(c => c.IsActive))
                        {
                            <option value="@c.Id">@c.Kind — @c.Label (@c.VouchersFiled filed)</option>
                        }
                    </select>
                    <span class="hint">Containers are created on the <a asp-page="/Filing/Containers" asp-route-roomId="@Model.EvidenceRoomId">paper files page</a>; the room's files and retention clock are on the <a asp-page="/Filing/Retention" asp-route-roomId="@Model.EvidenceRoomId">paper dashboard</a>.</span>
                </div>
                <div class="form-row">
                    <label asp-for="Physical.OccurredAtLocal">Date and time (evidence-room local)</label>
                    <input asp-for="Physical.OccurredAtLocal" type="datetime-local" />
                    <select asp-for="Physical.AmbiguousTimeChoice">
                        <option value="Unspecified">Not in the repeated DST hour</option>
                        <option value="Earlier">First occurrence</option>
                        <option value="Later">Second occurrence</option>
                    </select>
                </div>
                <div class="form-row">
                    <label asp-for="Physical.CopyReason">Copy-only reason (para 2-4g)</label>
                    <select asp-for="Physical.CopyReason" asp-items="Html.GetEnumSelectList<CopyRetentionReason>()"></select>
                </div>
                <div class="form-row">
                    <label asp-for="Physical.GainingEvidenceRoom">Gaining evidence room (para 2-7g transfer)</label>
                    <input asp-for="Physical.GainingEvidenceRoom" autocomplete="off" />
                </div>
                <div class="form-row">
                    <label asp-for="Physical.Narrative">Details</label>
                    <textarea asp-for="Physical.Narrative"></textarea>
                </div>
                <button type="submit">Record</button>
            </form>
        }
    </div>
}

<div class="panel">
    <h2>Scanned companion copies</h2>
    <p class="regulatory-note">
        Digital companion copies of paper documents. None of them is the original DA Form 4137;
        the paper record above says where that is.
    </p>
    @if (Model.SourceDocuments.Count > 0)
    {
        <table>
            <thead><tr><th>#</th><th>Type</th><th>What was scanned</th><th>Filename (metadata)</th><th>Pages</th><th>Received</th><th>Status</th></tr></thead>
            <tbody>
            @foreach (var doc in Model.SourceDocuments)
            {
                <tr>
                    <td><a asp-page="/Documents/View" asp-route-id="@doc.Id">@doc.Id</a></td>
                    <td>@doc.DocumentType</td>
                    <td>@doc.Provenance</td>
                    <td>@doc.OriginalFilename</td>
                    <td class="numeric">@doc.PageCount</td>
                    <td>@doc.ReceivedAtUtc.ToString("dd MMM yy HH:mm").ToUpperInvariant()Z</td>
                    <td>@doc.ImportStatus</td>
                </tr>
            }
            </tbody>
        </table>
    }
    @if (Model.CanUploadSourceDocument)
    {
        <p><a asp-page="/Documents/Upload" asp-route-voucherId="@Model.VoucherId">Upload a scanned document</a></p>
    }
</div>

@if (Model.DocumentNumbers.Count > 0)
{
    <div class="panel">
        <h2>Evidence document number</h2>
        <table>
            <thead>
                <tr><th>Number</th><th>Recorded</th><th>Status</th><th>Supersession reason</th></tr>
            </thead>
            <tbody>
            @foreach (var number in Model.DocumentNumbers)
            {
                <tr class="@(number.IsCurrent ? "" : "history-row--superseded")">
                    <td><span class="identifier">@number.DocumentNumber</span></td>
                    <td>@number.EnteredAtUtc.ToString("dd MMM yy HH:mm").ToUpperInvariant()</td>
                    <td>@(number.IsCurrent ? "Current" : "Superseded")</td>
                    <td>@number.SupersessionReason</td>
                </tr>
            }
            </tbody>
        </table>
        <p class="regulatory-note">
            AR 195-5 para 2-7g: on permanent transfer between evidence rooms the receiving
            custodian enters the receiving room's next document number, and the prior number "will
            be lined through in such a way that it remains legible." Superseded numbers are
            therefore kept and shown, not removed.
        </p>
    </div>
}

@if (Model.CanRecordDocumentNumber)
{
    <div class="panel">
        <h2>Record the official evidence document number</h2>
        <form method="post" asp-page-handler="RecordDocumentNumber" asp-route-id="@Model.VoucherId">
            <div asp-validation-summary="ModelOnly" class="message message--error"></div>

            <div class="form-row">
                <label asp-for="DocumentNumber.Value">Document number</label>
                <input asp-for="DocumentNumber.Value" placeholder="@Model.DocumentNumberExample" autocomplete="off" />
                <span class="hint">
                    Written as @Model.DocumentNumberFormatDescription.
                    @if (!Model.DocumentNumberLayoutIsRegulatory)
                    {
                        <text>
                            This is a LOCAL layout for this evidence room. AR 195-5 para 2-4c
                            prescribes a three-digit sequence beginning at 001, a hyphen, then the
                            two-digit calendar year (001-26). The number is recorded exactly as
                            written; its identity is the sequence and calendar year.
                        </text>
                    }
                    @if (Model.DocumentNumberLayoutAwaitsValidation)
                    {
                        <strong>
                            The local layout has no authority cited and is recorded as a legacy
                            practice awaiting validation.
                        </strong>
                    }
                </span>
                <span asp-validation-for="DocumentNumber.Value" class="field-validation-error"></span>
            </div>

            <div class="form-row">
                <label asp-for="DocumentNumber.ConfirmedCalendarYear">Calendar year (only if it differs from the date received)</label>
                <input asp-for="DocumentNumber.ConfirmedCalendarYear" type="number" min="1990" max="2199" autocomplete="off" />
                <span class="hint">
                    Leave blank normally: the year is taken from the date received. If the
                    two-digit year written on the form is not the year of receipt - a prior-year
                    form entered late, for example - the application will not guess the century;
                    enter the four-digit calendar year the number belongs to here.
                </span>
                <span asp-validation-for="DocumentNumber.ConfirmedCalendarYear" class="field-validation-error"></span>
            </div>

            <div class="form-row">
                <label asp-for="DocumentNumber.ReceivedAtLocal">Date and time received (local)</label>
                <input asp-for="DocumentNumber.ReceivedAtLocal" type="datetime-local" />
                <span class="hint">
                    Local time in the evidence room's own time zone, as written on the form or in
                    the ledger. Interpreted in that zone, not the server's.
                </span>
            </div>

            <div class="form-row">
                <label asp-for="DocumentNumber.AmbiguousTimeChoice">If the time falls in the hour repeated when clocks fall back</label>
                <select asp-for="DocumentNumber.AmbiguousTimeChoice">
                    <option value="Unspecified">Not applicable</option>
                    <option value="Earlier">First occurrence (still on daylight time)</option>
                    <option value="Later">Second occurrence (after the change to standard time)</option>
                </select>
                <span class="hint">
                    Once a year the 01:00 hour happens twice. A time in that hour is refused until
                    you say which occurrence is meant; a time in the hour skipped in spring is
                    refused outright. The application never picks for you.
                </span>
            </div>

            @if (Model.HasOfficialDocumentNumber)
            {
                <div class="form-row">
                    <label asp-for="DocumentNumber.SupersessionReason">Reason for superseding the current number</label>
                    <input asp-for="DocumentNumber.SupersessionReason" autocomplete="off" />
                    <span class="hint">Required. AR 195-5 para 2-7g.</span>
                </div>
            }

            <div class="form-row form-row--checkbox">
                <input asp-for="DocumentNumber.AttestedAssignedInAuthoritativeLedger" type="checkbox" />
                <label asp-for="DocumentNumber.AttestedAssignedInAuthoritativeLedger">
                    <strong>
                        I confirm this document number was assigned by order of precedence in the
                        authoritative evidence ledger (AR 195-5 paras 2-4c and 2-5a).
                    </strong>
                </label>
            </div>

            <p class="regulatory-note">
                This application operates as a companion under AR 195-5 para 2-5c and does not
                assign document numbers. Your confirmation, your name and the time are recorded
                with the entry.
            </p>

            <button type="submit">Record document number</button>
        </form>
    </div>
}
