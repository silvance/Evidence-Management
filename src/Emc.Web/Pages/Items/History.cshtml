@page "{id:int}"
@model Emc.Web.Pages.Items.HistoryModel
@{
    var view = Model.View!;
    ViewData["Title"] = $"{view.VoucherIdentifier} item {view.ItemNumber}";
}

<h1>
    Item @view.ItemNumber of <span class="identifier">@view.VoucherIdentifier</span>
</h1>
<p class="page-subtitle">
    Case <span class="identifier">@view.CaseControlNumber</span> &middot;
    <a asp-page="/Vouchers/Details" asp-route-id="@Model.VoucherId">back to voucher</a>
</p>

<partial name="_Messages" model="Model.Messages" />

@* AUD-008. The chain is verified on every view, so a break surfaces where someone will see it
   rather than only when an integrity report is deliberately run. *@
@if (view.ChainVerification.IsIntact)
{
    <div class="chain-status chain-status--intact">
        Integrity check passed — @view.ChainVerification.EventsChecked entries verified against
        this item's hash chain.
    </div>
}
else
{
    <div class="chain-status chain-status--broken" role="alert">
        <p>
            INTEGRITY CHECK FAILED. This item's accountability history does not match its hash
            chain, which means one or more entries were altered, inserted or removed outside this
            application. Notify the responsible CI supervisor and the system owner. Do not rely on
            this history until the discrepancy has been explained.
        </p>
        <ul>
            @foreach (var problem in view.ChainVerification.Problems)
            {
                <li>Entry #@problem.EventId (sequence @problem.SequenceNumber): @problem.Message</li>
            }
        </ul>
    </div>
}

@* AUD-021. Distinct from the chain check above. The history may be intact while the item's
   stored summary of it - status, last sequence, chain head - has been changed out of band. *@
@if (view.SnapshotVerification is { IsConsistent: false } snapshot)
{
    <div class="chain-status chain-status--broken" role="alert">
        <p>
            SNAPSHOT MISMATCH. This item's stored status or chain head does not agree with its
            accountability history. The history itself
            @(view.ChainVerification.IsIntact ? "verifies" : "does not verify either"); the
            summary fields were changed without a corresponding event. Notify the system owner.
            The history below is the record; the summary is not.
        </p>
        <ul>
            @foreach (var problem in snapshot.Problems)
            {
                <li>@problem.Kind: expected @problem.Expected, stored @problem.Actual. @problem.Message</li>
            }
        </ul>
    </div>
}

<div class="panel">
    <h2>Item</h2>
    <table>
        <tbody>
            <tr><th>Description of articles</th><td>@view.DescriptionForForm</td></tr>
            <tr><th>Accountability status</th><td>@view.AccountabilityStatus</td></tr>
            <tr>
                <th>Current location</th>
                <td>@(view.CurrentLocationPath ?? "Not recorded")</td>
            </tr>
            <tr>
                <th>Current custody</th>
                <td>@(view.CurrentCustodyHolder ?? "Not recorded")</td>
            </tr>
        </tbody>
    </table>
    <p class="regulatory-note">
        Current location and current custody are derived from the event history below, never
        stored as maintained state. AR 195-5's glossary defines chain of custody as "a
        chronological written record reflecting the release and receipt of evidence from initial
        acquisition until final disposition."
    </p>
</div>

<div class="panel">
    <h2>Chronological history</h2>
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Occurred (local)</th>
                <th>Entry</th>
                <th>Recorded by</th>
                <th>Entered</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var row in view.History)
        {
            var rowClass = row.HasCorrections
                ? "history-row--superseded"
                : row.Kind == ItemEventKind.Correction ? "history-row--correction" : null;

            <tr class="@rowClass">
                <td class="numeric">@row.SequenceNumber</td>
                <td>@row.OccurredAtLocal.ToString("dd MMM yy HH:mm").ToUpperInvariant()</td>
                <td>
                    <span class="history-summary">@row.Summary</span>
                    @if (row.HasCorrections)
                    {
                        <span class="corrected-marker">
                            corrected: @string.Join(", ", row.CorrectedFieldNames)
                        </span>
                        @* AUD-015. The value the record NOW reads, alongside the original above,
                           which stays readable per AR 195-5 2-5b(5). *@
                        <div class="regulatory-note">
                            @foreach (var field in row.CorrectedFieldNames)
                            {
                                <div>
                                    <strong>@field</strong> now reads:
                                    @(row.EffectiveFields[field] ?? "(blank)")
                                </div>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(row.Notes))
                    {
                        <div class="regulatory-note">@row.Notes</div>
                    }
                    @if (row.Kind == ItemEventKind.Correction)
                    {
                        <div class="regulatory-note">
                            Corrects entry #@row.CorrectsEventId.
                            @if (!string.IsNullOrWhiteSpace(row.CorrectionMfrReference))
                            {
                                <text>MFR @row.CorrectionMfrReference (AR 195-5 para 1-7c(3)).</text>
                            }
                            @if (!string.IsNullOrWhiteSpace(row.CorrectionSupervisorNotified))
                            {
                                <text>Supervisor informed: @row.CorrectionSupervisorNotified.</text>
                            }
                            @if (row.CorrectionCategory != CorrectionCategory.PostAcceptanceAccountabilityRecord)
                            {
                                @* A submitting agent correcting a draft (2-3g) or a transcription
                                   verification is not a custodian finding an incorrect entry, so
                                   1-7c(3)'s MFR and notification do not apply and their absence
                                   is not a defect. *@
                                <text>
                                    @row.CorrectionCategory — AR 195-5 para 1-7c(3) does not apply.
                                </text>
                            }
                        </div>
                    }
                </td>
                <td>@row.RecordedByName</td>
                <td>@row.RecordedAtUtc.ToString("dd MMM yy HH:mm").ToUpperInvariant()Z</td>
            </tr>
        }
        </tbody>
    </table>
    <p class="regulatory-note">
        A corrected entry is struck through and kept, never removed. AR 195-5 para 2-5b(5):
        "Erroneous entries will be voided with one line drawn through the entry (so it may still
        be read) and initialed by the custodian. No liquid correction type products, correction
        tape, stick-on labels, or erasures are authorized." Occurrence time is what the DA Form
        4137 records; entry time is when this application learned of it.
    </p>
</div>

@if (Model.CanAssignLocation)
{
    <div class="panel">
        <h2>Record an evidence-room location</h2>
        <form method="post" asp-page-handler="AssignLocation" asp-route-id="@view.ItemId">
            <div asp-validation-summary="ModelOnly" class="message message--error"></div>

            <div class="form-row">
                <label asp-for="Location.StorageLocationId">Location</label>
                <select asp-for="Location.StorageLocationId"
                        asp-items="@(new SelectList(Model.Locations, nameof(Emc.Web.Pages.Items.HistoryModel.LocationOption.Id), nameof(Emc.Web.Pages.Items.HistoryModel.LocationOption.Path)))">
                    <option value="">— select —</option>
                </select>
                <span asp-validation-for="Location.StorageLocationId" class="field-validation-error"></span>
            </div>

            <div class="form-row">
                <label asp-for="Location.OccurredAtLocal">Date and time (local)</label>
                <input asp-for="Location.OccurredAtLocal" type="datetime-local" />
                <span class="hint">
                    Local time in the evidence room's own time zone, as written on the form or in
                    the ledger. Interpreted in that zone, not the server's.
                </span>
            </div>

            <div class="form-row">
                <label asp-for="Location.AmbiguousTimeChoice">If the time falls in the hour repeated when clocks fall back</label>
                <select asp-for="Location.AmbiguousTimeChoice">
                    <option value="Unspecified">Not applicable</option>
                    <option value="Earlier">First occurrence (still on daylight time)</option>
                    <option value="Later">Second occurrence (after the change to standard time)</option>
                </select>
                <span class="hint">
                    Once a year the 01:00 hour happens twice. A time in that hour is refused until
                    you say which occurrence is meant; a time in the hour skipped in spring is
                    refused outright. The application never picks for you.
                </span>
            </div>

            <div class="form-row">
                <label asp-for="Location.Reason">Reason</label>
                <input asp-for="Location.Reason" autocomplete="off" />
            </div>

            <div class="form-row">
                <label asp-for="Location.Notes">Notes</label>
                <textarea asp-for="Location.Notes"></textarea>
            </div>

            <p class="regulatory-note">
                AR 195-5 para 2-4e requires the <em>current</em> location to be recorded in pencil
                in the location block of the DA Form 4137, kept current "by erasing the previous
                entry and noting the new location." This application retains the full history as a
                deliberate design and integrity control — the regulation does not require it, and
                this history may legitimately differ from the paper form, which by design shows
                only the current location.
            </p>

            <button type="submit">Record location</button>
        </form>
    </div>
}


@if (Model.CanRecordCustody)
{
    <div class="panel">
        <h2>Record a change of custody the paper shows (AR 195-5 para 2-3f)</h2>
        <p class="regulatory-note">
            For a chain-of-custody row that is on the DA Form 4137 and not yet in this companion — a hand receipt between agents, a release to the
            custodian. Recorded as of the date the paper shows; the entry time is kept separately. Not for a temporary release (record that on the
            voucher page, which also writes the custody event) and not a correction: bringing the companion up to the paper needs no para 1-7c(3) MFR.
        </p>
        <form method="post" asp-page-handler="RecordCustody" asp-route-id="@view.ItemId">
            <input type="hidden" asp-for="Custody.SourceDocumentId" />
            <input type="hidden" asp-for="Custody.ReconciliationFindingId" />
            @if (Model.Custody.ReconciliationFindingId is not null)
            {
                <p class="hint">Provenance: source document @Model.Custody.SourceDocumentId, reconciliation finding @Model.Custody.ReconciliationFindingId. The values below are the verified reading, offered as defaults for you to confirm or change.</p>
            }
            <fieldset>
                <legend>Released by</legend>
                <div class="form-row"><label asp-for="Custody.ReleasedByKind">Kind</label><select asp-for="Custody.ReleasedByKind" asp-items="Html.GetEnumSelectList<Emc.Domain.Common.CustodyPartyKind>()"></select></div>
                <div class="form-row"><label asp-for="Custody.ReleasedByUserId">EMC user (internal user)</label><select asp-for="Custody.ReleasedByUserId"><option value="">—</option>@foreach (var u in Model.Users) { <option value="@u.Id">@u.DisplayName</option> }</select></div>
                <div class="form-row"><label asp-for="Custody.ReleasedByName">Name as written</label><input asp-for="Custody.ReleasedByName" autocomplete="off" /></div>
                <div class="form-row"><label asp-for="Custody.ReleasedByTitleOrGrade">Grade or title</label><input asp-for="Custody.ReleasedByTitleOrGrade" autocomplete="off" /></div>
                <div class="form-row"><label asp-for="Custody.ReleasedByOrganization">Organization</label><input asp-for="Custody.ReleasedByOrganization" autocomplete="off" /></div>
                <div class="form-row"><label asp-for="Custody.ReleasedByMailNumber">Accountable mail number</label><input asp-for="Custody.ReleasedByMailNumber" autocomplete="off" /></div>
            </fieldset>
            <fieldset>
                <legend>Received by</legend>
                <div class="form-row"><label asp-for="Custody.ReceivedByKind">Kind</label><select asp-for="Custody.ReceivedByKind" asp-items="Html.GetEnumSelectList<Emc.Domain.Common.CustodyPartyKind>()"></select></div>
                <div class="form-row"><label asp-for="Custody.ReceivedByUserId">EMC user (internal user)</label><select asp-for="Custody.ReceivedByUserId"><option value="">—</option>@foreach (var u in Model.Users) { <option value="@u.Id">@u.DisplayName</option> }</select></div>
                <div class="form-row"><label asp-for="Custody.ReceivedByName">Name as written</label><input asp-for="Custody.ReceivedByName" autocomplete="off" /></div>
                <div class="form-row"><label asp-for="Custody.ReceivedByTitleOrGrade">Grade or title</label><input asp-for="Custody.ReceivedByTitleOrGrade" autocomplete="off" /></div>
                <div class="form-row"><label asp-for="Custody.ReceivedByOrganization">Organization</label><input asp-for="Custody.ReceivedByOrganization" autocomplete="off" /></div>
                <div class="form-row"><label asp-for="Custody.ReceivedByMailNumber">Accountable mail number</label><input asp-for="Custody.ReceivedByMailNumber" autocomplete="off" /></div>
            </fieldset>
            <div class="form-row"><label asp-for="Custody.Purpose">Purpose of change of custody</label><input asp-for="Custody.Purpose" autocomplete="off" /><span asp-validation-for="Custody.Purpose" class="field-validation-error"></span></div>
            <div class="form-row"><label asp-for="Custody.OccurredAtLocal">When it happened (the paper's date; evidence-room local)</label><input asp-for="Custody.OccurredAtLocal" type="datetime-local" />
                <select asp-for="Custody.AmbiguousTimeChoice"><option value="Unspecified">Not in the repeated DST hour</option><option value="Earlier">First occurrence</option><option value="Later">Second occurrence</option></select></div>
            <div class="form-row"><label><input asp-for="Custody.IsScrcni" /> SCRCNI — sealed container received, contents not inventoried (para 2-3e)</label></div>
            <div class="form-row"><label asp-for="Custody.Destination">Destination</label><input asp-for="Custody.Destination" autocomplete="off" /></div>
            <div class="form-row"><label asp-for="Custody.Agency">Agency</label><input asp-for="Custody.Agency" autocomplete="off" /></div>
            <div class="form-row"><label asp-for="Custody.Notes">Notes</label><textarea asp-for="Custody.Notes"></textarea></div>
            <button type="submit">Record change of custody</button>
        </form>
    </div>
}

@if (Model.CanRecordCorrection)
{
    <div class="panel">
        <h2>Record a correction</h2>
        <form method="post" asp-page-handler="RecordCorrection" asp-route-id="@view.ItemId">
            <div asp-validation-summary="ModelOnly" class="message message--error"></div>

            <div class="form-row">
                <label asp-for="Correction.CorrectedEventId">Entry to correct</label>
                <select asp-for="Correction.CorrectedEventId">
                    <option value="">— select —</option>
                    @* A field may be corrected more than once, and a correction may itself be
                       corrected, so every entry stays selectable. *@
                    @foreach (var row in view.History)
                    {
                        <option value="@row.EventId">#@row.SequenceNumber — @row.Summary</option>
                    }
                </select>
                <span asp-validation-for="Correction.CorrectedEventId" class="field-validation-error"></span>
            </div>

            <div class="form-row">
                <label asp-for="Correction.FieldName">Field corrected</label>
                <select asp-for="Correction.FieldName">
                    <option value="">— select the entry first —</option>
                    @foreach (var field in Model.CorrectableFieldsByEvent.Values.SelectMany(f => f).Distinct().OrderBy(f => f))
                    {
                        <option value="@field">@field</option>
                    }
                </select>
                <span class="hint">
                    Only fields the selected entry allows may be corrected. The server rejects
                    anything else.
                </span>
                <span asp-validation-for="Correction.FieldName" class="field-validation-error"></span>
            </div>

            <p class="regulatory-note">
                The value as originally recorded is <strong>derived by the application</strong>
                from the stored entry — it is not entered here, and cannot be. AR 195-5
                para 2-5b(5) requires the original to remain readable, and an original supplied
                from this screen could not be relied upon.
            </p>

            <div class="form-row">
                <label asp-for="Correction.CorrectedValue">Corrected value</label>
                <input asp-for="Correction.CorrectedValue" autocomplete="off" />
                <input type="hidden" asp-for="Correction.SourceDocumentId" />
                @if (Model.Correction.SourceDocumentId is not null)
                {
                    <span class="hint">Provenance: source document @Model.Correction.SourceDocumentId (reconciled from the verified scan). The link is hashed into the correction event.</span>
                }
                <span class="hint">
                    For a free-text field. Leave blank when correcting a storage location.
                </span>
            </div>

            <div class="form-row">
                <label asp-for="Correction.CorrectedStorageLocationId">
                    Replacement storage location
                </label>
                <select asp-for="Correction.CorrectedStorageLocationId">
                    <option value="">&mdash; not correcting a location &mdash;</option>
                    @foreach (var location in Model.Locations)
                    {
                        <option value="@location.Id">@location.Path</option>
                    }
                </select>
                <span class="hint">
                    Required when correcting
                    @string.Join(", ", Model.LocationReferenceFieldNames). An item's location is a
                    place in this evidence room, not a line of text: the monthly 100 percent
                    inventory (AR 195-5 para 3-1b(2)) and any discrepancy inquiry (para 3-3a) find
                    the item through it. Correcting the text alone would leave those pointing at
                    the container the record had just said was wrong, so the corrected path is
                    read from the location selected here.
                </span>
                <span asp-validation-for="Correction.CorrectedStorageLocationId" class="field-validation-error"></span>
            </div>

            <div class="form-row">
                <label asp-for="Correction.Reason">Reason for the correction</label>
                <textarea asp-for="Correction.Reason"></textarea>
                <span asp-validation-for="Correction.Reason" class="field-validation-error"></span>
            </div>

            <div class="form-row">
                <label asp-for="Correction.MfrReference">MFR reference</label>
                <input asp-for="Correction.MfrReference" autocomplete="off" />
                <span class="hint">
                    AR 195-5 para 1-7c(3): an MFR outlining the error and the corrective action,
                    filed with the proper DA Form 4137, with a copy in the case file.
                </span>
            </div>

            <div class="form-row">
                <label asp-for="Correction.SupervisorNotifiedUserId">Supervisor notified</label>
                <select asp-for="Correction.SupervisorNotifiedUserId"
                        asp-items="@(new SelectList(Model.Supervisors, nameof(Emc.Web.Pages.Items.HistoryModel.UserOption.Id), nameof(Emc.Web.Pages.Items.HistoryModel.UserOption.DisplayName)))">
                    <option value="">— none recorded —</option>
                </select>
                <span class="hint">
                    AR 195-5 para 1-7c(3) requires the responsible CI supervisor to be informed
                    immediately. Select the supervisor here if they hold an EMC account;
                    otherwise leave this blank and name them below.
                </span>
            </div>

            <div class="form-row">
                <label asp-for="Correction.SupervisorNotifiedName">Supervisor informed (no EMC account)</label>
                <input asp-for="Correction.SupervisorNotifiedName" autocomplete="off" placeholder="Printed name" />
                <input asp-for="Correction.SupervisorNotifiedGradeOrTitle" autocomplete="off" placeholder="Grade or title" />
                <input asp-for="Correction.SupervisorNotifiedOrganization" autocomplete="off" placeholder="Organization" />
                <span class="hint">
                    As the MFR names them. Ignored if a supervisor is selected above.
                </span>
            </div>

            <p class="regulatory-note">
                A correction to an accepted accountability record is <strong>not recorded</strong>
                without an MFR reference and a supervisor notification. AR 195-5 para 1-7c(3)
                makes both part of correcting the entry, not a follow-up to it.
            </p>

            <button type="submit">Record correction</button>
        </form>
    </div>
}
