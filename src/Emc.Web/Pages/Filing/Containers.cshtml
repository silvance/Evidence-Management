@page "/Filing/Containers/{roomId:int}"
@model Emc.Web.Pages.Filing.ContainersModel
@using Emc.Domain.Filing
@{
    ViewData["Title"] = "Paper DA Form 4137 files";
}

<h1>Paper DA Form 4137 files</h1>
<p><a asp-page="/Filing/Retention" asp-route-roomId="@Model.EvidenceRoomId">Paper files and retention dashboard</a></p>
<partial name="_Messages" model="Model.Messages" />

<p class="regulatory-note">
    AR 195-5 para 2-4f(1): active DA Forms 4137 are filed in numerical sequence, no more than
    50 vouchers with attached documents per folder or binder, the number range shown on the
    outside. Para 2-4f(3): at least three suspense folders — USACIL, ADJUDICATION, PENDING
    DISPOSITION APPROVAL. Para 2-4h: inactive files labeled by month and year of disposition,
    maintained in the evidence room. Folder or binder is the unit's choice.
</p>

<div class="panel">
    <table>
        <thead><tr><th>Kind</th><th>Label</th><th>Range / disposition</th><th>Form</th><th>Vouchers</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var c in Model.Containers)
        {
            <tr>
                <td>@c.Kind</td>
                <td>@c.Label</td>
                <td>@(c.DispositionLabel ?? (c.RangeFrom is null ? "—" : $"{c.RangeFrom} – {c.RangeTo}"))</td>
                <td>@c.Form</td>
                <td class="numeric">@c.VouchersFiled@(c.Kind == PhysicalFileKind.Active4137File ? $" / {PhysicalFileContainer.ActiveFileVoucherCapacity}" : "")</td>
                <td>@(c.IsActive ? "Open" : "Closed")</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (Model.CanManage)
{
    <div class="panel">
        <h2>Record a file container</h2>
        <form method="post" asp-route-roomId="@Model.EvidenceRoomId">
            <div asp-validation-summary="ModelOnly" class="message message--error"></div>
            <div class="form-row">
                <label asp-for="Input.Kind">Kind</label>
                <select asp-for="Input.Kind" asp-items="Html.GetEnumSelectList<PhysicalFileKind>()"></select>
            </div>
            <div class="form-row">
                <label asp-for="Input.Form">Folder or binder</label>
                <select asp-for="Input.Form" asp-items="Html.GetEnumSelectList<ContainerForm>()"></select>
            </div>
            <div class="form-row">
                <label asp-for="Input.Label">Label (as written on the outside)</label>
                <input asp-for="Input.Label" autocomplete="off" />
            </div>
            <div class="form-row">
                <label asp-for="Input.RangeCalendarYear">Document-number range (active files, para 2-4f(1)): year, first sequence, last sequence</label>
                <input asp-for="Input.RangeCalendarYear" type="number" min="1990" max="2200" placeholder="2026" />
                <input asp-for="Input.RangeFromSequence" type="number" min="1" placeholder="1" />
                <input asp-for="Input.RangeToSequence" type="number" min="1" placeholder="50" />
                <span class="hint">At most 50 numbers, one calendar year. The label range is rendered in this room's numbering layout; filing is checked against it.</span>
            </div>
            <div class="form-row">
                <label asp-for="Input.DispositionMonth">Disposition month / year (inactive files, para 2-4h)</label>
                <input asp-for="Input.DispositionMonth" type="number" min="1" max="12" placeholder="MM" />
                <input asp-for="Input.DispositionYear" type="number" min="1990" max="2200" placeholder="YYYY" />
            </div>
            <div class="form-row">
                <label asp-for="Input.Notes">Notes</label>
                <textarea asp-for="Input.Notes"></textarea>
            </div>
            <button type="submit">Record container</button>
        </form>
    </div>
}
