<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting configuration. The publish step adds the aspNetCore handler and process settings
  to this file; the request limit below is kept in source because IIS applies its own default
  (30,000,000 bytes) BEFORE the request reaches .NET, which would silently reject a source
  document upload at the configured 50 MB maximum (DOC-004). The figure is the application's
  SourceDocuments:MaxContentBytes plus 64 KB of multipart overhead, matching Program.cs.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="52494336" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
