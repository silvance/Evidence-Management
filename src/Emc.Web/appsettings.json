{
  "ConnectionStrings": {
    "Emc": "Server=.;Database=Emc;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SourceDocuments": {
    "_comment": "RootPath MUST be outside the site's physical path. The application-pool identity needs Modify on it; nothing else does. See docs/architecture.md section 9.",
    "RootPath": "D:\\EmcSourceDocuments",
    "MaxContentBytes": 52428800,
    "MaxPageCount": 200,
    "MaxPixelsPerPage": 30000000,
    "RenderDpi": 150,
    "RenderTimeoutSeconds": 60,
    "DuplicateRequestWindowSeconds": 120
  }
}
