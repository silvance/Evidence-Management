<?xml version="1.0" encoding="utf-8"?>
<!--
  CONNECTED STAGING configuration. Used for dependency research, restore with lock-file
  generation, vulnerability auditing and bundle export - never on the air-gapped host, which uses
  NuGet.Offline.Config instead.

  Sources are cleared first so that feeds configured on a developer's machine cannot take part in
  a restore that feeds the bundle. No credentials belong in this file.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </auditSources>
</configuration>
