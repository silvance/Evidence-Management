<?xml version="1.0" encoding="utf-8"?>
<!--
  AIR-GAPPED configuration. The ONLY package source is the verified dependency bundle, relative to
  this file. Inherited sources are cleared so that nothing can fall back to nuget.org or to a feed
  configured elsewhere on the machine, and audit sources are cleared because the bundle carries no
  vulnerability data - the audit was performed in connected staging when the bundle was produced
  (see docs/air-gapped-build-and-maintenance.md).

  Used by scripts/airgap/Restore-Build-Test-Offline.ps1, which verifies the bundle's hashes first,
  then restores in locked mode with this file as the configfile and EMC_OFFLINE=true.

  No credentials belong in this file.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="emc-dependency-bundle" value="dependency-bundle/packages" />
  </packageSources>
  <auditSources>
    <clear />
  </auditSources>
  <packageRestore>
    <add key="enabled" value="True" />
    <add key="automatic" value="False" />
  </packageRestore>
</configuration>
