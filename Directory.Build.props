<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Product version. Pre-1.0 while disposition, inspection and inventory are not built.
         scripts/release/New-ReleaseBundle.ps1 stamps the commit into the informational version
         (SourceRevisionId) so a deployed binary names the source it was built from. -->
    <VersionPrefix>0.9.0</VersionPrefix>
    <Deterministic>true</Deterministic>

    <!-- RELEASE BUNDLE (docs/release-bundle.md). The runtimes scripts/release may publish for:
         win-x64 is the deployment target (IIS in-process; the OCR worker as a Windows Service);
         linux-x64 exists for the test lane only. A publish for a runtime flows that runtime into
         every referenced project, so the identifiers are pinned here, solution-wide, and every
         packages.lock.json carries the runtime-specific graph: an offline, LOCKED restore from
         the dependency bundle can then publish without resolving anything new. Never
         self-contained: the ASP.NET Core Hosting Bundle from the dependency bundle supplies the
         runtime on the server, and the apphost packs travel in the bundle (Export-DependencyBundle). -->
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <!-- With runtimes pinned, the SDK would also download the RUNTIME packs
         (Microsoft.NETCore.App.Runtime.<rid>, Microsoft.AspNetCore.App.Runtime.<rid>) as
         package downloads the lock files never record - about 175 MB per runtime that a
         framework-dependent publish never uses. Off, so an offline restore from the bundle needs
         only what the lock files name plus the apphost packs. A self-contained publish is
         therefore impossible by construction, which is the intent. -->
    <EnableRuntimePackDownload>false</EnableRuntimePackDownload>

    <!-- Dependency advisories are audited, including transitives, at every severity, and a
         finding FAILS THE BUILD. On .NET 8 two advisories in
         Microsoft.AspNetCore.Authentication.Negotiate had no patched release, which forced
         NU1903 down to a warning; .NET 10 resolves them, so error severity is restored.
         docs/dependency-advisories.md records the process and the history. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>

    <!-- AIR-GAP SUPPLY CHAIN (docs/air-gapped-build-and-maintenance.md).

         Every project writes packages.lock.json, and the lock files are committed: the exact
         dependency graph is part of the reviewed source. An unexplained lock-file change IS a
         dependency change. Floating versions are not used anywhere.

         EMC_OFFLINE=true is set by the air-gapped restore script and by nothing else:
           - locked mode, so restore fails rather than resolving anything the lock does not name;
           - NuGetAudit off, because the offline bundle folder carries no vulnerability data. The
             audit is performed in the CONNECTED STAGING environment as part of producing the
             bundle, and its report travels with the bundle; the offline build restores only the
             packages that audit covered. Turning the audit off here is never a statement that
             the packages were checked against current data on the offline host. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(EMC_OFFLINE)' == 'true' or '$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
    <NuGetAudit Condition="'$(EMC_OFFLINE)' == 'true'">false</NuGetAudit>
  </PropertyGroup>
</Project>
